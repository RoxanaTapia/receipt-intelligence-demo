# Copy to .env and fill in secrets before compose up:
#   cp .env.example .env
#
# Local (no Caddy):
#   docker compose --env-file .env -f deploy/docker-compose.yml up --build -d
#
# Solo VPS / HTTPS (this repo’s Caddy — from repo root):
#   docker compose --env-file .env -p receipt-intelligence-demo \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.caddy.yml up --build -d
#
# Shared host with AI Doc Caddy (portfolio VPS — do NOT start this repo’s Caddy):
#   docker network create edge   # once
#   docker compose --env-file .env -p receipt-intelligence-demo \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.shared-edge.yml up --build -d
# See DEPLOYMENT.md for path choice, firewall, and verify steps.

# --- Secrets ---
ANTHROPIC_API_KEY=
# Optional API model override (set in .env if needed; not wired in compose by default)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# n8n basic auth (required) — separate from Caddy edge basic auth
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-strong-password

# --- Paths / service DNS ---
# Shared host folder: data/receipts (bind-mounted into both services).
# API container path is fixed in compose: RECEIPT_DATA_PATH=/data/receipts
# n8n Write File path: /home/node/.n8n-files/receipts

# On the Compose network, n8n / UX must reach the API by service name:
API_BASE_URL=http://api:8000
# UX → API (defaults to same service DNS; override only for odd local setups)
UX_API_BASE_URL=http://api:8000

# Demo UX (FastAPI) — local host publish without Caddy
UX_PORT=8080
# Browser-facing URL prefix for links/CSS. Leave empty for local :8080.
# Shared-edge and solo Caddy overlays default this to /app when unset.
UX_ROOT_PATH=
# Analytics window for seeded example receipts (stable; not rolling "last N days")
DEMO_START_DATE=2026-05-01
DEMO_END_DATE=2026-05-31
# UX → n8n demo ingest (Compose service DNS). Workflow must be Active in n8n.
# Do not point this at a public internet URL for arbitrary uploads.
N8N_INGEST_WEBHOOK_URL=http://n8n:5678/webhook/receipt-demo-ingest

# --- n8n server (local defaults) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Berlin

# --- Ports published to host (local smoke only; stripped by Caddy overlay) ---
API_PORT=8000
# Host port for the n8n UI (maps to container :5678). Change if 5678 is taken.
N8N_HOST_PORT=5678
WEBHOOK_URL=http://localhost:5678/
# When n8n is behind a reverse proxy at /n8n* (solo Caddy or shared AI Doc edge):
# N8N_PATH=/n8n
# N8N_HOST=demo.example.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://demo.example.com/n8n/
#
# Shared-host portfolio URL (AI Doc Caddy owns TLS — leave SITE_ADDRESS empty):
# N8N_HOST=receipt-intelligence.roxanatapia.dev
# N8N_PROTOCOL=https
# N8N_PATH=/n8n
# WEBHOOK_URL=https://receipt-intelligence.roxanatapia.dev/n8n/
N8N_PATH=

# --- API image build ---
# Default assumes sibling clones:
#   <parent>/receipt-intelligence-api
#   <parent>/receipt-intelligence-demo
# Override if your API clone lives elsewhere:
# API_BUILD_CONTEXT=/absolute/or/relative/path/to/receipt-intelligence-api

# =============================================================================
# HTTPS reverse proxy — solo VPS only (deploy/docker-compose.caddy.yml)
# =============================================================================
# Keep named volumes stable (omit -p if this is set):
COMPOSE_PROJECT_NAME=receipt-intelligence-demo

# Domain mode (Let's Encrypt). Example: demo.example.com
# On the AI Doc / shared-host VPS: leave empty — do not run docker-compose.caddy.yml.
SITE_ADDRESS=

# Interim IP demo without a domain — self-signed TLS on :443 (browser warning).
# Path is relative to the compose file directory (deploy/):
# CADDYFILE=./Caddyfile.ip

# Optional ACME contact email. Never use a placeholder default that contains "@"
# (breaks Caddy env expansion if wired into the Caddyfile).
ACME_EMAIL=

# Edge basic auth (solo Caddy only) lives in deploy/caddy-basicauth.conf (not here).
# Generate: ./deploy/generate-caddy-auth.sh demo 'YOUR_PASSWORD'
#
# Shared-host path: TLS + basic auth stay in ai-doc-to-chat-pipeline; use
# deploy/docker-compose.shared-edge.yml instead (aliases receipt-api / receipt-n8n).
