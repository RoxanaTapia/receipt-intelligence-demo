# Copy to .env and fill in secrets before compose up:
#   cp .env.example .env
#
# Local (no Caddy):
#   docker compose --env-file .env -f deploy/docker-compose.yml up --build -d
#
# VPS / HTTPS (Caddy overlay — from repo root):
#   docker compose --env-file .env -p receipt-intelligence-demo \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.caddy.yml up --build -d
# See DEPLOYMENT.md for firewall, domain vs IP-interim, and verify steps.

# --- Secrets ---
ANTHROPIC_API_KEY=
# Optional API model override (set in .env if needed; not wired in compose by default)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# n8n basic auth (required) — separate from Caddy edge basic auth
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-strong-password

# --- Paths / service DNS ---
# Shared host folder: data/receipts (bind-mounted into both services).
# API container path is fixed in compose: RECEIPT_DATA_PATH=/data/receipts
# n8n Write File path: /home/node/.n8n-files/receipts

# On the Compose network, n8n must reach the API by service name:
API_BASE_URL=http://api:8000

# --- n8n server (local defaults) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Berlin

# --- Ports published to host (local smoke only; stripped by Caddy overlay) ---
API_PORT=8000
# Host port for the n8n UI (maps to container :5678). Change if 5678 is taken.
N8N_HOST_PORT=5678
WEBHOOK_URL=http://localhost:5678/
# When using Caddy with /n8n* (see DEPLOYMENT.md), set e.g.:
# N8N_PATH=/n8n
# N8N_HOST=demo.example.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://demo.example.com/n8n/
N8N_PATH=

# --- API image build ---
# Default assumes sibling clones:
#   <parent>/receipt-intelligence-api
#   <parent>/receipt-intelligence-demo
# Override if your API clone lives elsewhere:
# API_BUILD_CONTEXT=/absolute/or/relative/path/to/receipt-intelligence-api

# =============================================================================
# HTTPS reverse proxy (deploy/docker-compose.caddy.yml + Caddy)
# =============================================================================
# Keep named volumes stable (omit -p if this is set):
COMPOSE_PROJECT_NAME=receipt-intelligence-demo

# Domain mode (Let's Encrypt). Example: demo.example.com
SITE_ADDRESS=

# Interim IP demo without a domain — self-signed TLS on :443 (browser warning).
# Path is relative to the compose file directory (deploy/):
# CADDYFILE=./Caddyfile.ip

# Optional ACME contact email. Never use a placeholder default that contains "@"
# (breaks Caddy env expansion if wired into the Caddyfile).
ACME_EMAIL=

# Edge basic auth lives in deploy/caddy-basicauth.conf (not here).
# Generate: ./deploy/generate-caddy-auth.sh demo 'YOUR_PASSWORD'
