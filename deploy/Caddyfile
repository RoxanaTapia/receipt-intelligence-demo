# Domain mode: Let's Encrypt via SITE_ADDRESS (set in repo-root .env).
# Generate auth: ./deploy/generate-caddy-auth.sh demo 'your-password'
#
# Visitor surface: demo UX under /app* (handle_path strips the prefix).
# API stays at / for /health, /analytics/*, /questions, /docs.
# Operator path: n8n under /n8n* — set N8N_PATH=/n8n and WEBHOOK_URL accordingly.

{$SITE_ADDRESS} {
	import /etc/caddy/caddy-basicauth.conf

	handle /n8n* {
		reverse_proxy n8n:5678
	}

	handle_path /app* {
		reverse_proxy ux:8080
	}

	handle {
		reverse_proxy api:8000
	}
}
